{
  "info": {
    "_postman_id": "c7e2b3a0-2f1b-4e9a-9d3a-fieldforce0002",
    "name": "FieldForceConnect - API Test",
    "description": "Login (valid/invalid) and Add Customer API tests for test.fieldforceconnect.com. Update the request URL/body in each request to match the real endpoint found via browser DevTools before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let jsonData = pm.response.json();",
                  "",
                  "// TODO: adjust this path once you see the real response shape",
                  "// e.g. jsonData.token, jsonData.data.access_token, etc.",
                  "let token = jsonData.token || (jsonData.data && jsonData.data.token);",
                  "",
                  "pm.test('Token received', function () {",
                  "    pm.expect(token).to.not.be.undefined;",
                  "});",
                  "",
                  "if (token) {",
                  "    pm.environment.set('auth_token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "TODO: Replace /api/auth/login with the actual endpoint captured from the browser Network tab when logging in through the UI."
          },
          "response": []
        },
        {
          "name": "Login - Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code indicates auth failure (401/400)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
                  "});",
                  "",
                  "pm.test('Response contains an error message', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(JSON.stringify(jsonData).toLowerCase()).to.match(/error|invalid|incorrect/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{invalid_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Same endpoint as valid login, but sent with an incorrect password to confirm the API rejects bad credentials."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Add Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Response confirms customer creation', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data').that.is.not.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"testcustomer@example.com\",\n  \"phone\": \"9999999999\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customers",
              "host": ["{{base_url}}"],
              "path": ["api", "customers"]
            },
            "description": "TODO: Replace /api/customers and the body fields with what you capture from the 'Add Customer' action on the dashboard. Confirm whether auth is sent as Bearer token or a custom header (e.g. x-auth-token)."
          },
          "response": []
        },
        {
          "name": "Get Customers (example GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customers",
              "host": ["{{base_url}}"],
              "path": ["api", "customers"]
            },
            "description": "Example GET request to list customers and verify the newly added customer appears. Update path/auth to match the real API."
          },
          "response": []
        }
      ]
    }
  ]
}
